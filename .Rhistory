library(MPRAnalyze)
data("ChrEpi")
obj <- MpraObject(
dnaCounts = ce.dnaCounts,
rnaCounts = ce.rnaCounts,
dnaAnnot = ce.colAnnot,
rnaAnnot = ce.colAnnot,
controls = ce.control
)
obj <- estimateDepthFactors(
obj,
lib.factor = "batch",
which.lib = "both"
)
obj <- analyzeQuantification(
obj,
dnaDesign = ~ 1,
rnaDesign = ~ 1
)
res <- testEmpirical(obj)
res
library(MPRAnalyze)
# load example dataset
data("ChrEpi")
# create object
obj <- MpraObject(
dnaCounts = ce.dnaCounts,
rnaCounts = ce.rnaCounts,
dnaAnnot = ce.colAnnot,
rnaAnnot = ce.colAnnot,
controls = ce.control
)
# show stuff in the object
print(obj)
# build design matrices manually
Xd <- model.matrix(~ 1, data=ce.colAnnot)
Xr <- model.matrix(~ 1, data=ce.colAnnot)
# show the design matrices
print(Xd)
print(Xr)
# estimate library size normalization factors
obj <- estimateDepthFactors(
obj,
lib.factor = "batch",
which.lib = "both"
)
# run analysis
obj <- analyzeQuantification(
obj,
dnaDesign = ~ barcode + batch,
rnaDesign = ~ 1
)
res <- testEmpirical(obj)
head(res)
dnaCounts
obj->dnaCounts
print(obj->dnaCounts)
obj <- analyzeQuantification(
obj,
dnaDesign = ~ 1,
rnaDesign = ~ 1
)
res <- testEmpirical(obj)
head(res)
